# En Vercel Services el navegador llama same-origin /api/... (rewrite → servicio api).
# Deja VITE_API_URL vacío en producción salvo que uses otro host.
VITE_API_URL=

# Socket.io solo si tienes un host Node persistente aparte (Railway/Render/Fly).
# En el despliegue Vercel Services (serverless) no hay sockets.
VITE_SOCKET_URL=
