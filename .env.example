# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/control_accesos?retryWrites=true&w=majority

# Servidor API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
JWT_EXPIRES_IN=7d

# CORS: orígenes web separados por comas. Usa * para cualquier origen.
# Incluye la URL de Vercel del frontend en producción.
# Los clientes móviles (Flutter) sin header Origin siempre se permiten.
CORS_ORIGIN=http://localhost:5173
CORS_VERCEL_PREVIEWS=true

# Zona horaria (México)
TZ=America/Mexico_City

# --- Frontend (build / Vercel) ---
# VITE_API_URL=https://tu-api.vercel.app
# VITE_SOCKET_URL=https://tu-api-persistente.ejemplo.com
